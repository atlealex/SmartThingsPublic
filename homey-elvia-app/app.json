{
  "id": "com.atlealex.elvia",
  "version": "1.0.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Elvia",
    "no": "Elvia"
  },
  "description": {
    "en": "Fetch grid tariff prices, fixed price levels, and max hours from the Elvia API",
    "no": "Hent nettleiepriser, fastprisnivå og makseffekt fra Elvia sitt API"
  },
  "category": ["energy"],
  "permissions": [],
  "author": {
    "name": "atlealex"
  },
  "brandColor": "#0F5C3D",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "capabilities": {
    "measure_price": {
      "type": "number",
      "title": {
        "en": "Grid tariff price",
        "no": "Nettleiepris"
      },
      "units": {
        "en": "NOK/kWh"
      },
      "decimals": 4,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "fixed_price_hourly": {
      "type": "number",
      "title": {
        "en": "Fixed price (hourly)",
        "no": "Fastpris (time)"
      },
      "units": {
        "en": "NOK/t"
      },
      "decimals": 4,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "fixed_price_monthly": {
      "type": "number",
      "title": {
        "en": "Fixed price (monthly)",
        "no": "Fastpris (måned)"
      },
      "units": {
        "en": "NOK/mnd"
      },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "fixed_price_level_info": {
      "type": "string",
      "title": {
        "en": "Fixed price level",
        "no": "Effektnivå"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "max_hours_average": {
      "type": "number",
      "title": {
        "en": "Average max hours",
        "no": "Snitt makseffekt"
      },
      "units": {
        "en": "kWh"
      },
      "decimals": 3,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "max_hour_rank": {
      "type": "number",
      "title": {
        "en": "Max hour",
        "no": "Makstime"
      },
      "units": {
        "en": "kWh"
      },
      "decimals": 3,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "consumption_previous_hour": {
      "type": "number",
      "title": {
        "en": "Consumption - previous hour",
        "no": "Forbruk - forrige time"
      },
      "units": {
        "en": "kWh"
      },
      "decimals": 3,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    }
  },
  "drivers": [
    {
      "id": "meter",
      "name": {
        "en": "Elvia metering point",
        "no": "Elvia målepunkt"
      },
      "class": "sensor",
      "capabilities": [
        "measure_price",
        "fixed_price_hourly",
        "fixed_price_monthly",
        "fixed_price_level_info",
        "consumption_previous_hour",
        "max_hours_average.current_month",
        "max_hours_average.previous_month",
        "max_hour_rank.current_1",
        "max_hour_rank.current_2",
        "max_hour_rank.current_3",
        "max_hour_rank.previous_1",
        "max_hour_rank.previous_2",
        "max_hour_rank.previous_3"
      ],
      "capabilitiesOptions": {
        "max_hours_average.current_month": {
          "title": {
            "en": "Average max hours - current month",
            "no": "Snitt makseffekt - inneværende måned"
          }
        },
        "max_hours_average.previous_month": {
          "title": {
            "en": "Average max hours - previous month",
            "no": "Snitt makseffekt - forrige måned"
          }
        },
        "max_hour_rank.current_1": {
          "title": {
            "en": "Max hour 1 - current month",
            "no": "Makstime 1 - inneværende måned"
          }
        },
        "max_hour_rank.current_2": {
          "title": {
            "en": "Max hour 2 - current month",
            "no": "Makstime 2 - inneværende måned"
          }
        },
        "max_hour_rank.current_3": {
          "title": {
            "en": "Max hour 3 - current month",
            "no": "Makstime 3 - inneværende måned"
          }
        },
        "max_hour_rank.previous_1": {
          "title": {
            "en": "Max hour 1 - previous month",
            "no": "Makstime 1 - forrige måned"
          }
        },
        "max_hour_rank.previous_2": {
          "title": {
            "en": "Max hour 2 - previous month",
            "no": "Makstime 2 - forrige måned"
          }
        },
        "max_hour_rank.previous_3": {
          "title": {
            "en": "Max hour 3 - previous month",
            "no": "Makstime 3 - forrige måned"
          }
        }
      },
      "platforms": ["local"],
      "connectivity": ["cloud"],
      "images": {
        "small": "/drivers/meter/assets/images/small.png",
        "large": "/drivers/meter/assets/images/large.png"
      },
      "pair": [
        {
          "id": "start",
          "navigation": {
            "next": "add_meter"
          }
        },
        {
          "id": "add_meter"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Elvia API",
            "no": "Elvia API"
          },
          "children": [
            {
              "id": "meteringPointId",
              "type": "text",
              "label": {
                "en": "Metering point ID (målepunkt-ID)",
                "no": "Målepunkt-ID"
              },
              "value": ""
            },
            {
              "id": "subscriptionKey",
              "type": "password",
              "label": {
                "en": "API subscription key",
                "no": "API-abonnementsnøkkel"
              },
              "value": ""
            },
            {
              "id": "accessToken",
              "type": "password",
              "label": {
                "en": "Personal access token (elvid.no)",
                "no": "Personlig tilgangstoken (elvid.no)"
              },
              "value": ""
            },
            {
              "id": "pollIntervalMinutes",
              "type": "number",
              "label": {
                "en": "Poll interval (minutes)",
                "no": "Oppdateringsintervall (minutter)"
              },
              "value": 30,
              "min": 1,
              "max": 720
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Fixed price steps (fastleddstrinn)",
            "no": "Fastleddstrinn"
          },
          "children": [
            {
              "id": "fixedPriceLevelsTable",
              "type": "label",
              "label": {
                "en": "All steps (updated automatically)",
                "no": "Alle trinn (oppdateres automatisk)"
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Advanced",
            "no": "Avansert"
          },
          "children": [
            {
              "id": "baseUrl",
              "type": "text",
              "label": {
                "en": "API base URL (leave empty for default)",
                "no": "API-grunn-URL (la stå tom for standard)"
              },
              "hint": {
                "en": "Only change this if Elvia has moved their API and requests fail. Default: https://elvia.azure-api.net",
                "no": "Endre kun dette hvis Elvia har flyttet API-et og kall feiler. Standard: https://elvia.azure-api.net"
              },
              "value": ""
            }
          ]
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "grid_tariff_price_changed",
        "title": {
          "en": "Grid tariff price changed",
          "no": "Nettleieprisen endret seg"
        },
        "tokens": [
          {
            "name": "price",
            "type": "number",
            "title": {
              "en": "Price (NOK/kWh)",
              "no": "Pris (NOK/kWh)"
            },
            "example": 0.4521
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=meter"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "price_above",
        "title": {
          "en": "Grid tariff price !{{is|is not}} above",
          "no": "Nettleieprisen !{{er|er ikke}} over"
        },
        "titleFormatted": {
          "en": "Grid tariff price !{{is|is not}} above [[price]]",
          "no": "Nettleieprisen !{{er|er ikke}} over [[price]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=meter"
          },
          {
            "name": "price",
            "type": "number",
            "title": {
              "en": "Price (NOK/kWh)",
              "no": "Pris (NOK/kWh)"
            },
            "placeholder": {
              "en": "0.50",
              "no": "0.50"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "refresh_now",
        "title": {
          "en": "Refresh Elvia data now",
          "no": "Oppdater Elvia-data nå"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=meter"
          }
        ]
      }
    ]
  }
}
