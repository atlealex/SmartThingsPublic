{
  "id": "com.atlealex.tibbercost",
  "version": "1.0.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Strømkostnad (Tibber)",
    "no": "Strømkostnad (Tibber)"
  },
  "description": {
    "en": "Track this month's electricity cost and estimate using Tibber consumption data",
    "no": "Følg strømkostnaden denne måneden og estimat, basert på Tibber-forbruk"
  },
  "category": ["energy"],
  "permissions": [],
  "author": {
    "name": "atlealex"
  },
  "brandColor": "#1B4B8F",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "capabilities": {
    "consumption_current_hour": {
      "type": "number",
      "title": {
        "en": "Consumption - current hour",
        "no": "Forbruk - denne timen"
      },
      "units": { "en": "kWh" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "consumption_today": {
      "type": "number",
      "title": {
        "en": "Consumption - today",
        "no": "Forbruk - i dag"
      },
      "units": { "en": "kWh" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "consumption_current_month": {
      "type": "number",
      "title": {
        "en": "Consumption - this month",
        "no": "Forbruk - denne måneden"
      },
      "units": { "en": "kWh" },
      "decimals": 1,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "consumption_estimate_month": {
      "type": "number",
      "title": {
        "en": "Consumption estimate - this month",
        "no": "Forbruksestimat - denne måneden"
      },
      "units": { "en": "kWh" },
      "decimals": 1,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "consumption_previous_month": {
      "type": "number",
      "title": {
        "en": "Consumption - previous month",
        "no": "Forbruk - forrige måned"
      },
      "units": { "en": "kWh" },
      "decimals": 1,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "consumption_yesterday": {
      "type": "number",
      "title": {
        "en": "Consumption - yesterday",
        "no": "Forbruk - i går"
      },
      "units": { "en": "kWh" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "consumption_year": {
      "type": "number",
      "title": {
        "en": "Consumption - this year",
        "no": "Forbruk - i år"
      },
      "units": { "en": "kWh" },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_current_month": {
      "type": "number",
      "title": {
        "en": "Cost - this month",
        "no": "Kostnad - denne måneden"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_estimate_month": {
      "type": "number",
      "title": {
        "en": "Cost estimate - this month",
        "no": "Kostnadsestimat - denne måneden"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_previous_month": {
      "type": "number",
      "title": {
        "en": "Cost - previous month",
        "no": "Kostnad - forrige måned"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_year": {
      "type": "number",
      "title": {
        "en": "Cost - this year",
        "no": "Kostnad - i år"
      },
      "units": { "en": "NOK" },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_energy_today": {
      "type": "number",
      "title": {
        "en": "Power cost - today",
        "no": "Strømkostnad - i dag"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_grid_today": {
      "type": "number",
      "title": {
        "en": "Grid rent cost - today",
        "no": "Nettleiekostnad - i dag"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_energy_yesterday": {
      "type": "number",
      "title": {
        "en": "Power cost - yesterday",
        "no": "Strømkostnad - i går"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_grid_yesterday": {
      "type": "number",
      "title": {
        "en": "Grid rent cost - yesterday",
        "no": "Nettleiekostnad - i går"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_energy_month": {
      "type": "number",
      "title": {
        "en": "Power cost - this month",
        "no": "Strømkostnad - denne måneden"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_grid_month": {
      "type": "number",
      "title": {
        "en": "Grid rent cost - this month",
        "no": "Nettleiekostnad - denne måneden"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_energy_previous_month": {
      "type": "number",
      "title": {
        "en": "Power cost - previous month",
        "no": "Strømkostnad - forrige måned"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_grid_previous_month": {
      "type": "number",
      "title": {
        "en": "Grid rent cost - previous month",
        "no": "Nettleiekostnad - forrige måned"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "cost_capacity_month": {
      "type": "number",
      "title": {
        "en": "Capacity charge (fastledd) - this month",
        "no": "Kapasitetsledd (fastledd) - denne måneden"
      },
      "units": { "en": "NOK" },
      "decimals": 2,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "capacity_level_info": {
      "type": "string",
      "title": {
        "en": "Capacity level",
        "no": "Effekttrinn"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "price_energy_now": {
      "type": "number",
      "title": {
        "en": "Power price - current hour",
        "no": "Strømpris - denne timen"
      },
      "units": { "en": "NOK/kWh" },
      "decimals": 3,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "price_grid_now": {
      "type": "number",
      "title": {
        "en": "Grid rent price - current hour",
        "no": "Nettleiepris - denne timen"
      },
      "units": { "en": "NOK/kWh" },
      "decimals": 3,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "price_total_now": {
      "type": "number",
      "title": {
        "en": "Total price - current hour",
        "no": "Totalpris - denne timen"
      },
      "units": { "en": "NOK/kWh" },
      "decimals": 3,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "average_price_today": {
      "type": "number",
      "title": {
        "en": "Average price - today",
        "no": "Snittpris - i dag"
      },
      "units": { "en": "NOK/kWh" },
      "decimals": 3,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    },
    "average_price_month_excl_vat": {
      "type": "number",
      "title": {
        "en": "Average price - this month, excl. VAT",
        "no": "Snittpris - denne måneden, eks. mva"
      },
      "units": { "en": "NOK/kWh" },
      "decimals": 3,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor"
    }
  },
  "drivers": [
    {
      "id": "meter",
      "name": {
        "en": "Strømkostnad",
        "no": "Strømkostnad"
      },
      "class": "sensor",
      "capabilities": [
        "measure_power",
        "consumption_current_hour",
        "consumption_today",
        "consumption_yesterday",
        "consumption_current_month",
        "consumption_estimate_month",
        "consumption_previous_month",
        "consumption_year",
        "cost_current_month",
        "cost_estimate_month",
        "cost_previous_month",
        "cost_year",
        "cost_energy_today",
        "cost_grid_today",
        "cost_energy_yesterday",
        "cost_grid_yesterday",
        "cost_energy_month",
        "cost_grid_month",
        "cost_energy_previous_month",
        "cost_grid_previous_month",
        "cost_capacity_month",
        "capacity_level_info",
        "price_energy_now",
        "price_grid_now",
        "price_total_now",
        "average_price_today",
        "average_price_month_excl_vat"
      ],
      "platforms": ["local"],
      "connectivity": ["cloud"],
      "images": {
        "small": "/drivers/meter/assets/images/small.png",
        "large": "/drivers/meter/assets/images/large.png"
      },
      "pair": [
        {
          "id": "start",
          "navigation": { "next": "add_meter" }
        },
        {
          "id": "add_meter"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": { "en": "Tibber", "no": "Tibber" },
          "children": [
            {
              "id": "tibberToken",
              "type": "password",
              "label": {
                "en": "Tibber API token",
                "no": "Tibber API-token"
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Electricity price",
            "no": "Strømpris"
          },
          "children": [
            {
              "id": "useSpotPrice",
              "type": "checkbox",
              "label": {
                "en": "Use spot price (from Tibber)",
                "no": "Bruk spotpris (fra Tibber)"
              },
              "value": true
            },
            {
              "id": "fixedPrice",
              "type": "number",
              "label": {
                "en": "Fixed price, if not using spot price (NOK/kWh)",
                "no": "Fastpris, hvis du ikke bruker spotpris (NOK/kWh)"
              },
              "value": 0,
              "min": 0
            },
            {
              "id": "markupOre",
              "type": "number",
              "label": {
                "en": "Markup on spot price (øre/kWh)",
                "no": "Påslag på spotpris (øre/kWh)"
              },
              "value": 0
            },
            {
              "id": "monthlyFee",
              "type": "number",
              "label": {
                "en": "Fixed monthly fee from your supplier (NOK/month)",
                "no": "Fast månedsgebyr fra strømleverandøren (NOK/måned)"
              },
              "value": 0,
              "min": 0
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Grid rent (nettleie) - optional",
            "no": "Nettleie - valgfritt"
          },
          "children": [
            {
              "id": "elviaSubscriptionKey",
              "type": "password",
              "label": {
                "en": "Elvia API subscription key",
                "no": "Elvia API-abonnementsnøkkel"
              },
              "hint": {
                "en": "Same key used in the Elvia-Nett app. Leave empty to exclude grid rent from the cost.",
                "no": "Samme nøkkel som i Elvia-Nett-appen. La stå tom for å utelate nettleie fra kostnaden."
              },
              "value": ""
            },
            {
              "id": "elviaMeteringPointId",
              "type": "text",
              "label": {
                "en": "Metering point ID (målepunkt-ID)",
                "no": "Målepunkt-ID"
              },
              "value": ""
            }
          ]
        }
      ]
    }
  ]
}
