{
  "id": "com.atlealex.sundimmer",
  "version": "1.4.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Sun Dimmer",
    "no": "Soldimmer"
  },
  "description": {
    "en": "Gradually dims your lights up during the day and down at night, transitioning smoothly around sunrise/sunset instead of switching abruptly",
    "no": "Dimmer lysene dine gradvis opp om dagen og ned om natten, med en jevn overgang rundt soloppgang/solnedgang i stedet for et brått hopp"
  },
  "category": ["lights"],
  "permissions": ["homey:manager:api", "homey:manager:geolocation"],
  "author": {
    "name": "atlealex"
  },
  "brandColor": "#F5A623",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "capabilities": {
    "next_sunset_text": {
      "type": "string",
      "title": {
        "en": "Next sunset dimming",
        "no": "Neste solnedgang-demping"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "next_sunrise_text": {
      "type": "string",
      "title": {
        "en": "Next sunrise brightening",
        "no": "Neste soloppgang-økning"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "light_min": {
      "type": "number",
      "title": { "en": "Min %", "no": "Min %" },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "units": { "en": "%", "no": "%" },
      "getable": true,
      "setable": true,
      "uiComponent": "slider"
    },
    "light_max": {
      "type": "number",
      "title": { "en": "Max %", "no": "Max %" },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "units": { "en": "%", "no": "%" },
      "getable": true,
      "setable": true,
      "uiComponent": "slider"
    },
    "light_level": {
      "type": "number",
      "title": { "en": "Level", "no": "Nivå" },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "units": { "en": "%", "no": "%" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    }
  },
  "drivers": [
    {
      "id": "sun_dimmer",
      "name": {
        "en": "Sun Dimmer",
        "no": "Soldimmer"
      },
      "class": "other",
      "capabilities": ["onoff.sunset", "onoff.sunrise", "next_sunset_text", "next_sunrise_text"],
      "capabilitiesOptions": {
        "onoff.sunset": {
          "title": { "en": "Sunset dimming active", "no": "Solnedgang-demping aktiv" }
        },
        "onoff.sunrise": {
          "title": { "en": "Sunrise brightening active", "no": "Soloppgang-økning aktiv" }
        }
      },
      "platforms": ["local"],
      "images": {
        "small": "/drivers/sun_dimmer/assets/images/small.png",
        "large": "/drivers/sun_dimmer/assets/images/large.png"
      },
      "pair": [
        {
          "id": "select_lights"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": { "en": "Transition", "no": "Overgang" },
          "children": [
            {
              "id": "transitionMinutes",
              "type": "number",
              "label": { "en": "Transition time (minutes)", "no": "Overgangstid (minutter)" },
              "hint": {
                "en": "How long the gradual dim takes, both at sunset and sunrise, for all lights in this group.",
                "no": "Hvor lenge den gradvise dimmingen tar, både ved solnedgang og soloppgang, for alle lysene i denne gruppen."
              },
              "value": 45,
              "min": 1,
              "max": 480
            },
            {
              "id": "sunsetOffsetMinutes",
              "type": "number",
              "label": { "en": "Start before sunset (minutes)", "no": "Start før solnedgang (minutter)" },
              "hint": {
                "en": "The evening dim starts this many minutes before actual sunset.",
                "no": "Solnedgang-demmingen starter dette antall minutter før faktisk solnedgang."
              },
              "value": 10,
              "min": 0,
              "max": 180
            },
            {
              "id": "sunriseOffsetMinutes",
              "type": "number",
              "label": { "en": "Start before sunrise (minutes)", "no": "Start før soloppgang (minutter)" },
              "hint": {
                "en": "The morning brightening starts this many minutes before actual sunrise.",
                "no": "Soloppgang-økningen starter dette antall minutter før faktisk soloppgang."
              },
              "value": 0,
              "min": 0,
              "max": 180
            },
            {
              "id": "pollIntervalSeconds",
              "type": "number",
              "label": { "en": "Update interval (seconds)", "no": "Oppdateringsintervall (sekunder)" },
              "hint": {
                "en": "How often the dim level is recalculated and sent to the lights while a transition is in progress. Lower values give smoother, more frequent steps but talk to the lights more often.",
                "no": "Hvor ofte dimmenivået regnes ut på nytt og sendes til lysene mens en overgang pågår. Lavere verdi gir jevnere, hyppigere steg, men snakker oftere med lysene."
              },
              "value": 30,
              "min": 5,
              "max": 300
            }
          ]
        }
      ]
    }
  ],
  "flow": {
    "actions": [
      {
        "id": "start_sunset_dim_now",
        "title": { "en": "Start sunset dimming now", "no": "Start solnedgang-demping nå" },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sun_dimmer"
          }
        ]
      },
      {
        "id": "start_sunrise_brighten_now",
        "title": { "en": "Start sunrise brightening now", "no": "Start soloppgang-økning nå" },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sun_dimmer"
          }
        ]
      }
    ]
  }
}
