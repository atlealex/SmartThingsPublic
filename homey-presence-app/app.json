{
  "id": "com.atlealex.homepresence",
  "version": "1.1.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Family presence",
    "no": "Familie hjemme"
  },
  "description": {
    "en": "Shows each family member's photo with a green/gray ring for home/away, driven by Homey's own presence flows",
    "no": "Viser bildet av hvert familiemedlem med grønn/grå ring for hjemme/borte, styrt av Homeys egne tilstedeværelses-flows"
  },
  "category": ["localization"],
  "permissions": [],
  "author": {
    "name": "atlealex"
  },
  "brandColor": "#3ECF5C",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "capabilities": {
    "home": {
      "type": "boolean",
      "title": {
        "en": "Home",
        "no": "Hjemme"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle"
    },
    "zone": {
      "type": "string",
      "title": {
        "en": "Zone",
        "no": "Sone"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "sensor"
    }
  },
  "drivers": [
    {
      "id": "person",
      "name": {
        "en": "Person",
        "no": "Person"
      },
      "class": "camera",
      "capabilities": ["home", "zone"],
      "platforms": ["local"],
      "connectivity": [],
      "images": {
        "small": "/drivers/person/assets/images/small.png",
        "large": "/drivers/person/assets/images/large.png"
      },
      "pair": [
        {
          "id": "add_person"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Photo",
            "no": "Bilde"
          },
          "children": [
            {
              "id": "photoUrl",
              "type": "text",
              "label": {
                "en": "Photo URL",
                "no": "Bilde-URL"
              },
              "hint": {
                "en": "A direct link to a photo of this person, e.g. one already hosted by Home Assistant on your local network.",
                "no": "En direkte lenke til et bilde av personen, f.eks. et du allerede har liggende i Home Assistant på hjemmenettverket."
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Order",
            "no": "Rekkefølge"
          },
          "children": [
            {
              "id": "sortOrder",
              "type": "number",
              "label": {
                "en": "Position in the widget (lower comes first)",
                "no": "Plassering i widgeten (lavere tall kommer først)"
              },
              "hint": {
                "en": "People with the same number are sorted by name.",
                "no": "Personer med samme tall sorteres etter navn."
              },
              "value": 0
            }
          ]
        }
      ]
    }
  ],
  "widgets": {
    "avatar": {
      "id": "avatar",
      "name": {
        "en": "Family",
        "no": "Familie"
      },
      "height": 140,
      "settings": [],
      "api": {
        "getPeople": {
          "method": "GET",
          "path": "/people"
        }
      }
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "became_home",
        "title": {
          "en": "Person came home",
          "no": "Person kom hjem"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=person"
          }
        ]
      },
      {
        "id": "became_away",
        "title": {
          "en": "Person left home",
          "no": "Person dro hjemmefra"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=person"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_home",
        "title": {
          "en": "Person !{{is|is not}} home",
          "no": "Person !{{er|er ikke}} hjemme"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=person"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "mark_home",
        "title": {
          "en": "Mark person as home",
          "no": "Sett person som hjemme"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=person"
          }
        ]
      },
      {
        "id": "mark_away",
        "title": {
          "en": "Mark person as away",
          "no": "Sett person som borte"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=person"
          }
        ]
      },
      {
        "id": "mark_zone",
        "title": {
          "en": "Mark person as in a zone",
          "no": "Sett person i en sone"
        },
        "titleFormatted": {
          "en": "Mark as in zone [[zone]]",
          "no": "Sett i sone [[zone]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=person"
          },
          {
            "name": "zone",
            "type": "text",
            "title": {
              "en": "Zone name",
              "no": "Sonenavn"
            },
            "placeholder": {
              "en": "e.g. Work",
              "no": "f.eks. Jobb"
            }
          }
        ]
      }
    ]
  }
}
